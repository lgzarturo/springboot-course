# =============================================================================
# Configuración de Sentry (Observabilidad y Error Tracking)
# Organización: arthurolg-to | Proyecto: springboot-course
# MCP Endpoint: https://mcp.sentry.dev/mcp/arthurolg-to/springboot-course
# =============================================================================
SENTRY_ORG=arthurolg-to
SENTRY_PROJECT=springboot-course
SENTRY_DSN=https://7c67fb09a21335b3c95362f679b104c3@o4509285737365504.ingest.us.sentry.io/4510258835554304
# Token de autenticación de Sentry para subida de source bundles y CLI (sntrys_... o sntryu_...)
# Generar en: https://sentry.io/settings/account/api/auth-tokens/ (scopes requeridos: project:releases, org:read)
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=development
SENTRY_DEBUG=false
SENTRY_ENABLED=true
SENTRY_LOGGING_ENABLED=true
SENTRY_TRACES_SAMPLE_RATE=1.0

# =============================================================================
# Base de Datos (PostgreSQL / Docker Compose)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=springboot_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_URL=jdbc:postgresql://localhost:5432/springboot_db

# =============================================================================
# Autenticación / Auth0 (Opcional para Resource Server / OAuth2)
# =============================================================================
# AUTH0_DOMAIN=your-tenant.auth0.com
# AUTH0_AUDIENCE=https://api.springboot-course.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
